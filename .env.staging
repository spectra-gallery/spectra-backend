# Spectra API — staging

# Server
NODE_ENV=production
PORT=8000
BASE_URL=https://api.staging.spectra.gallery/
CLIENT_URL=https://staging.spectra.gallery
STORAGE_API_URL=https://storage.staging.spectra.gallery

# WebAuthn
RP_ID=staging.spectra.gallery
WEBAUTHN_ORIGIN=https://api.staging.spectra.gallery

# DB (staging)
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=spectra_staging
DB_USER=
DB_PASSWORD=
DB_AUTH_SOURCE=spectra

# Auth (set real secrets via secure ops channel)
JWT_SECRET=
SESSION_SECRET=
API_SESSION_SECRET=
STORAGE_SESSION_SECRET=

# Feature flags
DISABLE_AUTO_SETUP=1
SKIP_DB=0

# Optional integrations
ETH_API_URL=
ETH_PRIVATE_KEY=
DAO_CONTRACT_ADDRESS=
SPECTRA_CONTRACT_ADDRESS=
GEN_OFFSET=0
STRIPE_SECRET_KEY=
MAIL_HOST=mail.infomaniak.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
SPECTRA_EMAIL=artist@spectra.gallery
ADMIN_EMAIL=

