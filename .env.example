# Spectra API — staging/production example

# Mongo (if using username/password auth)
DB_HOST=localhost
DB_PORT=27017
DB=spectra
AUTH_SOURCE=admin
DB_USER=
DB_PASSWORD=

# HTTP port
PORT=8000

# CORS origins (frontend + storage)
CLIENT_URL=http://localhost:3000
STORAGE_API_URL=http://localhost:6601

# External base URL (optional, used in some controllers)
BASE_URL=https://your-domain

# Blockchain integrations (optional)
ETH_API_URL=
ETH_PRIVATE_KEY=
DAO_CONTRACT_ADDRESS=
SPECTRA_CONTRACT_ADDRESS=
GEN_OFFSET=0

# Puppeteer concurrency for server-side rendering tasks
PUPPETEER_MAX_CONCURRENCY=1

# Payments (optional)
STRIPE_SECRET_KEY=

# Mempool / explorer base (optional)
MEMPOOL_ADDRESS=https://mempool.space

# Mailer (optional)
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=

# Admin/ops
DAO_GRANT_SECRET=
ADMIN_DASH_DIR=
